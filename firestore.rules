rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      allow read: if request.auth != null && (resource.data.ownerId == request.auth.uid || resource.data.members.hasAny([request.auth.uid]));
      allow write: if request.auth != null && (request.resource.data.ownerId == request.auth.uid || request.resource.data.members.hasAny([request.auth.uid]));
    }
  }
}
